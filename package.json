{
  "name": "@flun/node-mobile-app",
  "version": "2.0.2",
  "description": "将 Node.js 项目一键打包为 Android / iOS 移动应用,运行时由 @flun/nodejs-mobile-react-native 提供,无需修改你的 Node 代码;",
  "author": "flun <open@flun.top>",
  "keywords": [
    "node-mobile",
    "nodejs",
    "nodejs-mobile",
    "react-native",
    "android",
    "ios",
    "mobile",
    "mobile-app",
    "apk",
    "ipa",
    "express",
    "webview",
    "cli"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin/",
    "cli-assets/",
    "scripts/",
    "src/",
    "template/",
    "自定义libnode指南.md",
    "Android 构建指南.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "mobileAppConfig.js",
    "package.json"
  ],
  "scripts": {
    "postinstall": "node scripts/copy-files.js"
  },
  "dependencies": {
    "@babel/core": "^8.0.6",
    "@react-native-community/cli": "^20.2.0",
    "@react-native-community/cli-platform-android": "^20.2.0",
    "@react-native-community/cli-platform-ios": "^20.2.0",
    "@react-native/babel-preset": "^0.87.1",
    "@react-native/metro-config": "^0.87.1",
    "jimp": "^1.6.1",
    "react": "^19.3.0",
    "react-native": "^0.87.1",
    "react-native-webview": "^14.0.1",
    "@types/react": "^19.3.0",
    "prettier": "^3.9.8",
    "eslint": "^10.11.0",
    "@eslint/js": "^10.0.1",
    "@babel/eslint-parser": "^7.29.9",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "@flun/nodejs-mobile-react-native": "^1.0.3"
  },
  "allowScripts": {
    "node": true,
    "@flun/nodejs-mobile-react-native": true,
    "unrs-resolver": true,
    "@parcel/watcher": true
  },
  "homepage": "https://github.com/OpenFlun/node-mobile-app#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenFlun/node-mobile-app.git"
  },
  "gitee": "https://gitee.com/OpenFlun/node-mobile-app.git",
  "bugs": {
    "url": "https://github.com/OpenFlun/node-mobile-app/issues"
  },
  "license": "ISC",
  "engines": {
    "node": ">= 18.20.4"
  },
  "bin": {
    "node-mobile-app": "./bin/cli.js"
  }
}